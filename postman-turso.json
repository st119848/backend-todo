{
  "info": {
    "_postman_id": "768de853-bce9-40c5-b6c5-d27177664c38",
    "name": "Todo API - Turso",
    "description": "Postman collection for the Turso-backed Express API in todo-turso.js. Configure TURSO_DATABASE_URL and TURSO_AUTH_TOKEN, start the API, and run the requests in order for a complete CRUD workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "todoId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Todo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test the Turso Todo API\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/todos",
        "description": "Creates a persistent todo and saves its generated ID as the collection variable todoId."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Created todo has a generated ID', function () {",
              "  const todo = pm.response.json();",
              "  pm.expect(todo.id).to.be.a('number');",
              "  pm.collectionVariables.set('todoId', String(todo.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/todos"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Todo by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/todos/{{todoId}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns the requested todo', function () {",
              "  const todo = pm.response.json();",
              "  pm.expect(String(todo.id)).to.eql(pm.collectionVariables.get('todoId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Todo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Turso todo\",\n  \"completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/todos/{{todoId}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Todo is updated', function () {",
              "  const todo = pm.response.json();",
              "  pm.expect(todo.title).to.eql('Updated Turso todo');",
              "  pm.expect(todo.completed).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Todo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/todos/{{todoId}}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns the deleted todo', function () {",
              "  const todo = pm.response.json();",
              "  pm.expect(String(todo.id)).to.eql(pm.collectionVariables.get('todoId'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
